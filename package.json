{
  "name": "ict3902c-aiplaywright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:demo": "cross-env ENV=DEMO playwright test",
    "test:dev": "cross-env ENV=DEV playwright test",
    "test:uat": "cross-env ENV=UAT playwright test",
    "test:prod": "cross-env ENV=PROD playwright test",
    "test:html": "cross-env HTML_REPORT=1 playwright test",
    "report": "node core/reporting/generateReport.js --open",
    "report:html": "playwright show-report reports/html-report",
    "analyze": "node core/reporting/analyzeFailures.js",
    "diagnose": "npm run analyze && npm run report",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.10"
  }
}
