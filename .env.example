# Copy this file to .env and fill in what you need. .env is git-ignored.

# Which config/<ENV>/config.json to load (DEMO, SIT, ...)
ENV=DEMO

# ---- AI diagnosis (optional) ----
# ollama (local, default) or gemini
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Masking ----
# Values from data/sensitive shorter than this are not masked (default 4)
SENSITIVE_MASK_MIN_LENGTH=4

# ---- Report behaviour (all optional; 0/false/no/off disables) ----
# HTML_REPORT=1       also build Playwright's built-in HTML report in reports/html-report
# AI_REPORT=0         disable the AI report reporter entirely
# AI_DIAGNOSE=0|1     0 = never call the AI provider, 1 = force it even if no provider looks configured
# AI_COMPARE=1        run every prompt variant instead of just the default
# AI_REPORT_OPEN=1    open the AI report in the browser when the run finishes
